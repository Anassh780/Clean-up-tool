/* Sweep — dark console theme */

Screen {
    background: #070a0f;
    color: #c9d6e4;
}

/* ------------------------------------------------------------------ shell */
#topbar {
    height: 3;
    background: #0b1119;
    border-bottom: solid #16202b;
    padding: 0 1;
}

#top-brand {
    width: 1fr;
    height: 2;
    content-align: left middle;
}

#top-info {
    width: auto;
    height: 2;
    content-align: right middle;
}

#body {
    height: 1fr;
}

#sidebar {
    width: 27;
    height: 1fr;
    background: #090e15;
    border-right: solid #16202b;
    padding: 1 1;
}

#brand {
    height: 3;
    padding: 0 1;
    content-align: left middle;
}

.nav-item {
    height: 2;
    padding: 0 1;
    content-align: left middle;
    color: #64748b;
}

.nav-item:hover {
    background: #111a24;
    color: #c9d6e4;
}

.nav-item.active {
    background: #0f2733;
}

#sidebar-spacer {
    height: 1fr;
}

SafetyCard {
    height: 5;
    border: round #1a2530;
    background: #0b1119;
    padding: 0 1;
    content-align: left middle;
}

#views {
    width: 1fr;
    height: 1fr;
    padding: 1 2 0 2;
}

#statusbar {
    height: 2;
    background: #0b1119;
    border-top: solid #16202b;
    padding: 0 1;
    content-align: left middle;
    color: #64748b;
}

/* --------------------------------------------------------------- dashboard */
#view-dashboard {
    overflow-x: hidden;
    padding-right: 1;
}

#hero {
    height: 8;
}

#logo {
    width: 46;
    height: 7;
    content-align: left top;
}

#hero-text {
    width: 1fr;
    height: 7;
    padding: 1 0 0 2;
}

#hero-title {
    text-style: bold;
    color: #e2e8f0;
    height: 1;
}

#hero-sub {
    color: #94a3b8;
    height: 1;
    margin-top: 1;
}

#hero-tags {
    color: #22d3ee;
    height: 1;
    margin-top: 1;
}

#stat-row {
    height: 6;
    margin-top: 1;
}

StatCard {
    width: 1fr;
    height: 6;
    border: round #1a2530;
    background: #0b1119;
    padding: 0 1;
    margin-right: 1;
}

StatCard:focus {
    border: round #22d3ee;
}

.section {
    height: 1;
    margin-top: 2;
    color: #64748b;
    text-style: bold;
}

#drive-lines {
    height: auto;
    margin-top: 1;
    padding: 0 1;
}

#quick-actions {
    height: 3;
    margin-top: 1;
}

#quick-actions Button {
    margin-right: 1;
    min-width: 19;
}

#activity {
    height: 8;
    margin-top: 1;
    border: round #1a2530;
    background: #0b1119;
    padding: 0 1;
    scrollbar-size-vertical: 0;
}

/* -------------------------------------------------------------------- panes */
.pane-head {
    height: 3;
}

.pane-title-wrap {
    width: 1fr;
    height: 2;
}

.pane-title {
    text-style: bold;
    color: #e2e8f0;
    height: 1;
}

.pane-sub {
    color: #64748b;
    height: 1;
}

.pane-meta {
    width: auto;
    height: 2;
    content-align: right middle;
}

.actions {
    height: 3;
    margin-top: 1;
}

.actions Button {
    margin-right: 1;
}

.progress-label {
    width: 1fr;
    height: 3;
    content-align: right middle;
    color: #64748b;
    padding-right: 1;
}

.detail {
    height: 2;
    padding: 0 1;
    color: #64748b;
}

.empty-state {
    height: 1fr;
    width: 1fr;
    content-align: center middle;
    text-align: center;
    color: #475569;
    padding: 1 6;
}

#remover-input {
    width: 1fr;
    margin-right: 1;
}

#remover-options {
    height: 3;
}

#procs-spacer {
    width: 1fr;
}

/* ------------------------------------------------------------------ widgets */
Button {
    height: 3;
    min-width: 11;
    padding: 0 1;
    border: round #22303f;
    background: #131c26;
    color: #c9d6e4;
}

Button:hover {
    background: #1b2836;
    border: round #2c3e52;
}

Button.-primary {
    background: #0e7490;
    border: round #0e7490;
    color: #ecfeff;
    text-style: bold;
}

Button.-primary:hover {
    background: #0891b2;
    border: round #0891b2;
}

Button.-error {
    background: #7f1d1d;
    border: round #7f1d1d;
    color: #fee2e2;
}

Button.-error:hover {
    background: #991b1b;
    border: round #991b1b;
}

Button.-warning {
    background: #78350f;
    border: round #78350f;
    color: #fef3c7;
}

Button.-success {
    background: #065f46;
    border: round #065f46;
    color: #d1fae5;
}

Button.filter {
    min-width: 8;
    background: #101822;
    color: #94a3b8;
}

Button.filter.active {
    background: #0e7490;
    border: round #0e7490;
    color: #ecfeff;
    text-style: bold;
}

Button:disabled {
    opacity: 0.45;
}

Input {
    height: 3;
    border: round #22303f;
    background: #0b1119;
    color: #e2e8f0;
}

Input:focus {
    border: round #22d3ee;
}

Button.toggle {
    min-width: 14;
}

DataTable {
    height: 1fr;
    background: #0b1119;
    border: round #1a2530;
    padding: 0 1;
}

DataTable > .datatable--header {
    background: #0e1721;
    color: #7dd3fc;
    text-style: bold;
}

DataTable > .datatable--cursor {
    background: #16283a;
    color: #f1f5f9;
    text-style: bold;
}

DataTable:focus > .datatable--cursor {
    background: #1b3a4d;
}

DataTable > .datatable--even-row {
    background: #0a0f16;
}

DataTable > .datatable--odd-row {
    background: #0b1119;
}

DataTable > .datatable--hover {
    background: #12202c;
}

ProgressBar {
    height: 1;
    width: 1fr;
    margin-bottom: 1;
}

ProgressBar Bar {
    width: 1fr;
}

ProgressBar > Bar > .bar--bar {
    color: #22d3ee;
    background: #16202b;
}

ProgressBar > Bar > .bar--complete {
    color: #34d399;
    background: #16202b;
}

ProgressBar > Bar > .bar--indeterminate {
    color: #a78bfa;
    background: #16202b;
}

/* ------------------------------------------------------------------ dialogs */
ConfirmScreen, HelpScreen, SettingsScreen {
    align: center middle;
    background: #000000 65%;
}

#dialog {
    width: 76;
    max-width: 92%;
    height: auto;
    border: round #22d3ee;
    background: #0b1119;
    padding: 1 2;
}

#dialog.wide {
    width: 88;
}

/* The key list gained an Updates row, so on a 24-row terminal the dialog
   scrolls as a whole instead of clipping its title and Close button. */
HelpScreen #dialog {
    max-height: 100%;
    overflow-y: auto;
}

HelpScreen #dialog-hint {
    margin-top: 0;
}

#dialog-title {
    height: 1;
    color: #22d3ee;
    text-style: bold;
    margin-bottom: 1;
}

#dialog-body {
    height: auto;
    color: #c9d6e4;
}

#dialog-hint {
    height: auto;
    color: #64748b;
    margin-top: 1;
}

#dialog-input {
    margin-top: 1;
}

#dialog-buttons {
    height: 3;
    margin-top: 1;
    align-horizontal: right;
}

#dialog-buttons Button {
    margin-left: 1;
}

.setting-row {
    height: 3;
    margin-top: 1;
}

.setting-label {
    width: 1fr;
    height: 3;
    content-align: left middle;
    color: #c9d6e4;
}

.setting-note {
    height: 1;
    color: #64748b;
}

#settings-info {
    height: auto;
    margin-top: 1;
    padding: 0 1;
    color: #94a3b8;
    background: #0a0f16;
    border: round #16202b;
}

#settings-actions {
    height: 3;
    margin-top: 1;
}

#settings-actions Button {
    margin-right: 1;
}

/* Settings grew an update card, so it needs a scrollable body on small
   terminals while the Close row stays pinned to the bottom. */
SettingsScreen #dialog {
    height: 90%;
    max-height: 92%;
}

#settings-scroll {
    height: 1fr;
    scrollbar-size-vertical: 1;
}

.settings-section {
    height: 1;
    margin-top: 1;
    color: #64748b;
    text-style: bold;
}

#updates-status {
    height: auto;
    padding: 0 1;
    color: #c9d6e4;
}

#updates-actions {
    height: 6;
    margin-top: 1;
}

.updates-row {
    height: 3;
}

.updates-row Button {
    margin-right: 1;
    min-width: 11;
}

#updates-url {
    height: auto;
    color: #64748b;
}

#updates-note {
    height: auto;
    color: #fbbf24;
}
